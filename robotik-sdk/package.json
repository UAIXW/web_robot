{
  "name": "@robotik/sdk",
  "version": "0.1.0",
  "description": "悬浮对话机器人 SDK — Shadow DOM 隔离 · 拖拽 · SSE 流式 · 通用嵌入",
  "files": [
    "dist"
  ],
  "main": "./dist/robot.js",
  "module": "./dist/robot.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/robot.js",
  "jsdelivr": "./dist/robot.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/robot.mjs",
      "require": "./dist/robot.js",
      "default": "./dist/robot.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && tsc --emitDeclarationOnly --outDir .dts-tmp && node rollup.dts.config.mjs && rm -rf .dts-tmp",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
